# Generated by ai-infra for service "{{ svc.name }}".
{% if svc.runtime == "python" %}
# ---------- Python: builder stage ----------
FROM {{ svc.image }} AS builder

WORKDIR /app
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install pinned requirements first so this layer is cached across code changes.
COPY requirements.txt* ./
RUN if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
COPY . .
RUN if [ ! -f requirements.txt ] && [ -f pyproject.toml ]; then pip install .; fi

# ---------- Python: runtime stage ----------
FROM {{ svc.image }}

WORKDIR /app
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
COPY --from=builder /opt/venv /opt/venv
COPY . .
{% if not svc.run_as_root %}
RUN useradd --create-home --uid 10001 app 2>/dev/null || adduser -D -u 10001 app
USER 10001
{% endif %}
{% elif svc.runtime == "node" %}
# ---------- Node.js: builder stage ----------
FROM {{ svc.image }} AS builder

WORKDIR /app
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY . .
# Build (TypeScript, Next.js, NestJS, ...) with dev dependencies, then drop them.
RUN npm run build --if-present && npm prune --omit=dev

# ---------- Node.js: runtime stage ----------
FROM {{ svc.image }}

WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder --chown=node:node /app ./
{% if not svc.run_as_root %}
USER node
{% endif %}
{% elif svc.runtime == "go" %}
# ---------- Go: builder stage ----------
FROM {{ svc.image }} AS builder

WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
# Build the module's first main package (covers both ./main.go and ./cmd/<name>).
RUN pkg="$(go list -f '{% raw %}{{if eq .Name "main"}}{{.ImportPath}}{{end}}{% endraw %}' ./... | awk 'NF {print; exit}')" \
 && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/server "$pkg"

# ---------- Go: runtime stage ----------
FROM gcr.io/distroless/static-debian12{{ "" if svc.run_as_root else ":nonroot" }}

COPY --from=builder /out/server /server
{% elif svc.runtime == "java" %}
# ---------- Java: builder stage ----------
FROM {{ svc.image }} AS builder

WORKDIR /app
COPY . .
RUN if [ -f pom.xml ]; then mvn -B -q package -DskipTests; \
    elif [ -f gradlew ]; then ./gradlew build -x test; \
    else gradle build -x test; fi \
 && mkdir -p /out \
 && cp "$(ls target/*.jar build/libs/*.jar 2>/dev/null | grep -v -e '-plain\.jar$' -e '-sources\.jar$' | head -n1)" /out/app.jar

# ---------- Java: runtime stage ----------
FROM eclipse-temurin:21-jre

WORKDIR /app
COPY --from=builder /out/app.jar app.jar
{% if not svc.run_as_root %}
RUN useradd --uid 10001 app
USER 10001
{% endif %}
{% else %}
# ---------- Generic: single stage ----------
FROM {{ svc.image }}

WORKDIR /app
COPY . .
{% endif %}

{% for port in svc.ports %}
EXPOSE {{ port.container }}{% if port.protocol == "UDP" %}/udp{% endif %}

{% endfor %}

{% if svc.runtime == "go" %}
# distroless images have no shell, so the binary is the entrypoint.
ENTRYPOINT ["/server"]
{% elif svc.entrypoint %}
CMD {{ svc.entrypoint }}
{% elif svc.runtime == "java" %}
CMD ["java", "-jar", "app.jar"]
{% endif %}
