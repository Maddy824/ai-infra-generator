# Generated by ai-infra. Values for ${VARS} are read from .env
# (see .env.example).
services:
{% for svc in model.services %}
  {{ svc.name }}:
{% if svc.built %}
    build:
      context: .
      dockerfile: Dockerfile.{{ svc.name }}
{% else %}
    image: {{ svc.image }}
{% endif %}
{% if svc.entrypoint and not svc.built %}
    command: {{ svc.entrypoint | tojson }}
{% endif %}
    restart: unless-stopped
{% if svc.ports %}
    ports:
{% for port in svc.ports %}
      - "{{ port.host }}:{{ port.container }}{% if port.protocol == "UDP" %}/udp{% endif %}"
{% endfor %}
{% endif %}
{% if svc.depends_on %}
    depends_on:
{% for dep in svc.depends_on %}
      - {{ dep }}
{% endfor %}
{% endif %}
{% if svc.env %}
    environment:
{% for env_name, env_var in svc.env.items() %}
{% if env_var.kind == "literal" %}
      {{ env_name }}: {{ env_var.value | tojson }}
{% else %}
      {{ env_name }}: "${{'{'}}{{ env_var.ref }}{{'}'}}"
{% endif %}
{% endfor %}
{% endif %}
{% if svc.volumes %}
    volumes:
{% for vol in svc.volumes %}
      - {{ vol.name }}:{{ vol.mount_path }}
{% endfor %}
{% endif %}

{% endfor %}
{% set all_volumes = [] %}
{% for svc in model.services %}
{% for vol in svc.volumes %}
{% if vol.name not in all_volumes %}{% if all_volumes.append(vol.name) %}{% endif %}{% endif %}
{% endfor %}
{% endfor %}
{% if all_volumes %}
volumes:
{% for vol_name in all_volumes %}
  {{ vol_name }}:
{% endfor %}
{% endif %}
