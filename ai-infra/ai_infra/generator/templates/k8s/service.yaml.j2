apiVersion: v1
kind: Service
metadata:
  name: {{ svc.name | tojson }}
  labels:
    app: {{ svc.name | tojson }}
    project: {{ model.project_name | tojson }}
spec:
  type: ClusterIP
  selector:
    app: {{ svc.name | tojson }}
  ports:
{% for port in svc.ports %}
    - port: {{ port.container }}
      targetPort: {{ port.container }}
      protocol: {{ port.protocol | tojson }}
{% endfor %}
