apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ claim | tojson }}
  labels:
    project: {{ model.project_name | tojson }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ model.cluster_assumptions.storage_class | tojson }}
  resources:
    requests:
      storage: {{ size | tojson }}
