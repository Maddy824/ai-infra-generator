{% set ca = model.cluster_assumptions %}
{% set tls = "true" if ca.tls_enabled else "false" %}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ model.project_name }}-ingress
  labels:
    project: {{ model.project_name }}
  annotations:
{% if ca.ingress_controller == "nginx" %}
    nginx.ingress.kubernetes.io/ssl-redirect: "{{ tls }}"
{% elif ca.ingress_controller == "traefik" %}
    traefik.ingress.kubernetes.io/router.entrypoints: {{ "websecure" if ca.tls_enabled else "web" }}
    traefik.ingress.kubernetes.io/router.tls: "{{ tls }}"
{% elif ca.ingress_controller == "alb" %}
    alb.ingress.kubernetes.io/scheme: internet-facing
    alb.ingress.kubernetes.io/target-type: ip
{% if ca.tls_enabled %}
    alb.ingress.kubernetes.io/listen-ports: '[{"HTTP": 80}, {"HTTPS": 443}]'
    alb.ingress.kubernetes.io/ssl-redirect: "443"
{% endif %}
{% endif %}
{% if ca.tls_enabled and ca.cert_manager and ca.ingress_controller != "alb" %}
    cert-manager.io/cluster-issuer: letsencrypt-prod
{% endif %}
spec:
  ingressClassName: {{ "alb" if ca.ingress_controller == "alb" and ca.ingress_class_name == "nginx" else ca.ingress_class_name }}
{% if ca.tls_enabled and ca.ingress_controller != "alb" %}
  tls:
    - hosts:
{% for svc in app_services %}
        - {{ svc.host }}
{% endfor %}
      secretName: {{ model.project_name }}-tls
{% endif %}
  rules:
{% for svc in app_services %}
    - host: {{ svc.host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ svc.name }}
                port:
                  number: {{ svc.ports[0].container }}
{% endfor %}
