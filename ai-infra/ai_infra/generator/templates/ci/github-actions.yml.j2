name: Build and Deploy
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

env:
  REGISTRY: {{ cicd.registry }}
  IMAGE_PREFIX: {{ model.project_name }}

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write

    steps:
      - uses: actions/checkout@v4

      - uses: docker/setup-buildx-action@v3

      - name: Log in to container registry
        if: github.event_name != 'pull_request'
        uses: docker/login-action@v3
        with:
          registry: ${{ '{{' }} env.REGISTRY {{ '}}' }}
          username: ${{ '{{' }} github.actor {{ '}}' }}
          password: ${{ '{{' }} secrets.GITHUB_TOKEN {{ '}}' }}

{% if cicd.lint %}
      - name: Lint
        run: echo "Add your lint command here"
{% endif %}

{% if cicd.run_tests %}
      - name: Test
        run: echo "Add your test command here"
{% endif %}

{% for svc in app_services %}
      - name: Build and push {{ svc.name }}
        uses: docker/build-push-action@v6
        with:
          context: .
          file: Dockerfile.{{ svc.name }}
          push: ${{ '{{' }} github.event_name != 'pull_request' {{ '}}' }}
          tags: |
            ${{ '{{' }} env.REGISTRY {{ '}}' }}/${{ '{{' }} env.IMAGE_PREFIX {{ '}}' }}/{{ svc.name }}:${{ '{{' }} github.sha {{ '}}' }}
            ${{ '{{' }} env.REGISTRY {{ '}}' }}/${{ '{{' }} env.IMAGE_PREFIX {{ '}}' }}/{{ svc.name }}:latest
          cache-from: type=gha,scope={{ svc.name }}
          cache-to: type=gha,mode=max,scope={{ svc.name }}
{% endfor %}

{% if cicd.auto_deploy %}
  deploy:
    needs: build
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'

    steps:
      - uses: actions/checkout@v4

{% if cicd.cluster_auth == "aws" %}
      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ '{{' }} secrets.AWS_ACCESS_KEY_ID {{ '}}' }}
          aws-secret-access-key: ${{ '{{' }} secrets.AWS_SECRET_ACCESS_KEY {{ '}}' }}
          aws-region: {{ model.iac.region }}

      - name: Update kubeconfig
        run: aws eks update-kubeconfig --name {{ model.iac.cluster_name or model.project_name }} --region {{ model.iac.region }}
{% elif cicd.cluster_auth == "gke" %}
      - name: Authenticate to GKE
        uses: google-github-actions/auth@v2
        with:
          credentials_json: ${{ '{{' }} secrets.GCP_SA_KEY {{ '}}' }}

      - name: Get GKE credentials
        uses: google-github-actions/get-gke-credentials@v2
        with:
          cluster_name: {{ model.iac.cluster_name or model.project_name }}
          location: {{ model.iac.region }}
{% elif cicd.cluster_auth == "azure" %}
      - name: Azure login
        uses: azure/login@v2
        with:
          creds: ${{ '{{' }} secrets.AZURE_CREDENTIALS {{ '}}' }}

      - name: Get AKS credentials
        uses: azure/aks-set-context@v4
        with:
          resource-group: ${{ '{{' }} vars.AKS_RESOURCE_GROUP {{ '}}' }}
          cluster-name: {{ model.iac.cluster_name or model.project_name }}
{% else %}
      - name: Configure kubeconfig
        run: |
          mkdir -p ~/.kube
          echo "${{ '{{' }} secrets.KUBECONFIG {{ '}}' }}" > ~/.kube/config
{% endif %}

      - name: Deploy to Kubernetes
        run: |
          kubectl apply -f k8s/
{% for svc in app_services %}
          kubectl set image deployment/{{ svc.name }} {{ svc.name }}=${{ '{{' }} env.REGISTRY {{ '}}' }}/${{ '{{' }} env.IMAGE_PREFIX {{ '}}' }}/{{ svc.name }}:${{ '{{' }} github.sha {{ '}}' }}
{% endfor %}
{% for svc in app_services %}
          kubectl rollout status deployment/{{ svc.name }} --timeout=5m
{% endfor %}
{% endif %}
