# Prometheus ServiceMonitor for {{ svc.name }}
# Generated by ai-infra
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: {{ (svc.name ~ "-monitor") | tojson }}
  labels:
    app: {{ svc.name | tojson }}
    project: {{ model.project_name | tojson }}
spec:
  selector:
    matchLabels:
      app: {{ svc.name | tojson }}
  endpoints:
    - port: metrics
      path: {{ monitoring.metrics_path | tojson }}
      interval: 30s
